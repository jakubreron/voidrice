#!/bin/sh
set ratios 1:2:3
set previewer ~/.config/lf/preview
set rulerfile ~/.config/lf/ruler.tmpl
set shell zsh
set shellopts '-euy'
set ifs "\n"
set scrolloff 7
set icons
set period 1
set incsearch
set incfilter
set hidden
set drawbox
set roundbox
set info size
set number
set relativenumber

cmd on-redraw %{{
  if [ "$lf_width" -le 80 ]; then
    lf -remote "send $id set ratios 1:2"
  elif [ "$lf_width" -le 160 ]; then
    lf -remote "send $id set ratios 1:2:3"
  else
    lf -remote "send $id set ratios 1:2:3:5"
  fi
}}

cmd open ${{
  os="$(uname)"
  filepath="$(realpath "$f" 2>/dev/null || readlink -f "$f" 2>/dev/null || echo "$f")"
  mime="$(file --mime-type "$filepath" -b)"
  if [ "$os" = "Darwin" ]; then
    case "$mime" in
      text/*|application/json|inode/x-empty|application/x-subrip) $EDITOR $fx ;;
      application/pgp-encrypted) $EDITOR $fx ;;
      audio/*|video/x-ms-asf) mpv --audio-display=no $f ;;
      *) open $fx >/dev/null 2>&1 ;;
    esac
  else
    case "$mime" in
      application/vnd.openxmlformats-officedocument.spreadsheetml.sheet) localc $fx ;;
      image/vnd.djvu|application/pdf|application/epub*|application/octet-stream|application/postscript) setsid -f zathura $fx >/dev/null 2>&1 ;;
      text/*|application/json|inode/x-empty|application/x-subrip) $EDITOR $fx ;;
      image/x-xcf) setsid -f gimp $f >/dev/null 2>&1 ;;
      image/svg+xml) display -- $f ;;
      image/*) setsid -f $GUI_IMAGE_VIEWER $f >/dev/null 2>&1 ;;
      audio/*|video/x-ms-asf) mpv --audio-display=no $f ;;
      video/*) setsid -f mpv $f -quiet >/dev/null 2>&1 ;;
      application/vnd*) setsid -f libreoffice $fx >/dev/null 2>&1 ;;
      application/pgp-encrypted) $EDITOR $fx ;;
      *) for f in $fx; do setsid -f $OPENER $f >/dev/null 2>&1; done ;;
    esac
  fi
}}

cmd fzf_jump $lf -remote "send $id cd $(awk '{ gsub(/#.*/, ""); } !/^$/ { print $2 }' $ZDOTDIR/bookmarks/dirs | fzf | sed "s/\${.*-// ; s/}//" | envsubst)"

cmd notify %{{
  case "$(uname)" in
    Darwin) osascript -e "display notification \"$2\" with title \"$1\"" ;;
    *) notify-send "$1" "$2" ;;
  esac
}}

cmd delete ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  set -f
  printf "$fx \n"
  printf "❌ Delete? [y/n] "
  read ans
  ans="${ans:-y}"
  [ $ans = "y" ] && rm -rf -- $fx
}}

cmd extract ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  set -f
  printf "$fx \n"
  printf "📦 Extract? [y/n] "
  read ans
  ans="${ans:-y}"
  if [ $ans = "y" ]; then
  case $fx in
    *.tar.bz2)   tar xjf $fx     ;;
    *.tar.gz)    tar xzf $fx     ;;
    *.bz2)       bunzip2 $fx     ;;
    *.rar)       unrar x $fx     ;;
    *.gz)        gunzip $fx      ;;
    *.tar)       tar xf $fx      ;;
    *.tbz2)      tar xjf $fx     ;;
    *.tgz)       tar xzf $fx     ;;
    *.zip)       unzip $fx       ;;
    *.Z)         uncompress $fx  ;;
    *.7z)        7z x $fx        ;;
    *.tar.xz)    tar xf $fx      ;;
    *.tar.zst|*.tzst) tar xf $fx ;;
    *.xz)        unxz $fx        ;;
  esac
fi
}}

cmd moveto ${{
  set -f
  clear; tput cup $(($(tput lines)/3))
  dest="$(sed -e 's/[[:space:]]*#.*//' -e '/^$/d' -e 's/^[^[:space:]]*[[:space:]]*//' $ZDOTDIR/bookmarks/dirs | fzf --layout=reverse --height 40% --prompt 'Move to where? ' | sed 's|~|$HOME|')"
  [ -z "$dest" ] && exit
  dest_path=$(eval printf '%s' \"$dest\")
  clear; tput cup $(($(tput lines)/3)); tput bold
  echo "From:"
  echo "$fx" | sed 's/^/   /'
  printf "To:\n   %s\n\n\tmove?[y/N]" "$dest_path"
  read -r ans
  [ "$ans" != "y" ] && exit
  for x in $fx; do
    mv -iv -- "$x" "$dest_path"
  done
  lf -remote "send $id cd $dest_path"
  lf -remote "send $id notify \" File(s) moved.\" \"File(s) moved to $dest.\""
}}

cmd copyto ${{
  set -f
  clear; tput cup $(($(tput lines)/3))
  dest="$(sed -e 's/[[:space:]]*#.*//' -e '/^$/d' -e 's/^[^[:space:]]*[[:space:]]*//' $ZDOTDIR/bookmarks/dirs | fzf --layout=reverse --height 40% --prompt 'Copy to where? ' | sed 's|~|$HOME|')"
  [ -z "$dest" ] && exit
  dest_path=$(eval printf '%s' \"$dest\")
  clear; tput cup $(($(tput lines)/3)); tput bold
  echo "From:"
  echo "$fx" | sed 's/^/   /'
  printf "To:\n   %s\n\n\tcopy?[y/N]" "$dest_path"
  read -r ans
  [ "$ans" != "y" ] && exit
  for x in $fx; do
    cp -ivr -- "$x" "$dest_path"
  done
  lf -remote "send $id cd $dest_path"
  lf -remote "send $id notify \" File(s) copied.\" \"File(s) copied to $dest.\""
}}

cmd share ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  set -f
  printf "$fx \n"
  for x in $fx; do
    case "$x" in
      *.gpg) ;;
      *) echo "❌ Not encrypted: $x" && sleep 3 && exit 1 ;;
    esac
  done
  printf "🌐 Share? [y/n] "
  read ans
  ans="${ans:-y}"
  if [ $ans = "y" ]; then
    for x in $fx; do
      curl -sS -F"file=@$x" https://tmpfiles.org/api/v1/upload | sed -n 's/.*"url": *"\([^"]*\)".*/\1/p' | sed 's#\\##g; s#^http://#https://#; s#tmpfiles.org/#tmpfiles.org/dl/#' | cross-platform-copy
    done
  fi
}}

cmd fzf_search $lf -remote "send $id select \"$(fzf)\""

cmd mkdir %{{
  IFS=" "
  file="$*"
  mkdir -p -- "$file"
  lf -remote "send $id select \"$(printf '%s' "$file" | sed 's/\\/\\\\/g;s/"/\\"/g')\""
}}

cmd encrypt ${{
  for x in $fx; do
    gpg -c --pinentry-mode loopback --s2k-mode 3 --s2k-count 65011712 --s2k-digest-algo SHA512 --cipher-algo AES256 "$x"
  done
}}
cmd decrypt ${{
  for x in $fx; do
    gpg -d -o "${x%.gpg}" "$x"
  done
}}

cmd zip ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  set -f
  printf "$fx \n"
  printf "📦 Zip to: "
  read -r name
  zip -r -- "$name.zip" $fx
}}

cmd kdeconnect ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  set -f
  clear; echo "Send to which device?"
  dest="$(kdeconnect-cli -a | cut -f1 -d ':' | cut -c 3- | fzf)" &&
  for x in $fx; do
    eval kdeconnect-cli --share=\"$x\" --name=\"$dest\"
  done &&
  lf -remote "send $id notify \" Sending file(s)\" \"Sending file(s) to $dest.\""
}}

cmd dragon %dragon-drop -a -x $fx

cmd convert ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  set -f
  printf "$fx \n"
  printf "💱 Convert to: "
  read -r name
  magick "$f" "$name"
}}

cmd bulk_rename ${{
  old="$(mktemp)"
  new="$(mktemp)"
  if [ -n "$fs" ]; then
    fs="$(printf '%s\n' $fs | while IFS= read -r filepath; do basename -- "$filepath"; done)"
  else
    fs="$(ls)"
  fi
  printf '%s\n' "$fs" > "$old"
  printf '%s\n' "$fs" > "$new"
  $EDITOR "$new"
  [ "$(wc -l < "$new")" -ne "$(wc -l < "$old")" ] && exit
  paste "$old" "$new" | while IFS= read -r names; do
    src="$(printf '%s' "$names" | cut -f1)"
    dst="$(printf '%s' "$names" | cut -f2)"
    if [ "$src" = "$dst" ] || [ -e "$dst" ]; then
      continue
    fi
    mv -- "$src" "$dst"
  done
  rm -- "$old" "$new"
  lf -remote "send $id unselect"
}}

cmd open_in_new_terminal ${{
  case "$(uname)" in
    Darwin) $TERMINAL --working-directory "$PWD" >/dev/null 2>&1 & ;;
    *) setsid -f $TERMINAL >/dev/null 2>&1 ;;
  esac
}}

cmd follow_link %{{
  lf -remote "send $id select \"$(readlink -- "$f" | sed 's/\\/\\\\/g;s/"/\\"/g')\""
}}

# Bindings
nmap J fzf_jump
# map V push :!$EDITOR<space>
map D delete
map E extract
map M moveto
map C copyto
nmap U set hidden!

nmap gl follow_link
map ge encrypt
map gd decrypt
map gc convert
map gs share
map gk kdeconnect

nmap <c-f> fzf_search
nmap <c-n> push :mkdir<space>""<left>
map <c-o> dragon

map Z zip

nmap x $$f # execute
nmap X $chmod +x "$f" && lf -remote "send reload"
nmap o ${{
  case "$(uname)" in
    Darwin) open "$f" ;;
    *) mimeopen "$f" ;;
  esac
}}
nmap O ${{
  case "$(uname)" in
    Darwin) open -a "$(osascript -e 'choose application' 2>/dev/null)" "$f" ;;
    *) mimeopen --ask "$f" ;;
  esac
}}

# Renames
nmap r push A<c-u> # new rename
nmap R bulk_rename

nmap i :rename # before extension
nmap I :rename; cmd-home # at the very beginning

nmap a :rename; cmd-right # after extension
nmap A :rename; cmd-end # at the very end

nmap W open_in_new_terminal

# TODO: @Jakub check if it sill works on Linux
map Y $printf "%s" "$fx" | cross-platform-copy
map . $printf "%s" "$fx" | sed 's/.*\///' | cross-platform-copy

# Source Bookmarks
source "~/.config/lf/shortcutrc"
