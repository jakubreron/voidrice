{
  "memory": {
    "interval": 10,
    "format": "󰘚 {used:0.1f}G",
    "states": {
      "warning": 75,
      "critical": 90
    },
    "format-warning": "󰀧 {used:0.1f}G",
    "format-critical": "󰀧 {used:0.1f}G",
    "min-length": 8,
    "max-length": 8,
    "tooltip-format": "Memory Used: {used:0.2f} GiB / {total:0.2f} GiB ({percentage}%)",
    "on-click": "$TERMINAL --title cli_system_monitor --command $CLI_SYSTEM_MONITOR"
  }
}
