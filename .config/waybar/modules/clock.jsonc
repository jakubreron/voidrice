{
  "clock#time": {
    "interval": 60,
    "format": "{:%I:%M}",
    "min-length": 5,
    "max-length": 5,
    "timezones": [
      "",
      "Europe/Warsaw",
    "Asia/Tokyo"
    ],
    "timezone-tooltip-format": "{:%H:%M %Z}",
    "tooltip-format": "{tz_list}"
  },
  "clock#date": {
    "interval": 60,
    "format": "󰸗 {:%Y-%m-%d}",
    "actions": {
      "on-click": "mode"
    },
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "format": {
        "months": "<span alpha='100%'>{}</span>",
        "days": "<span alpha='85%'>{}</span>",
        "weekdays": "<span alpha='60%'><i>{}</i></span>",
        "today": "<span alpha='100%'><u>{}</u></span>"
      }
    },
    "tooltip-format": "{calendar}"
  }
}
