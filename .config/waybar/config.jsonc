{
  "layer": "top",
  "position": "top", // Waybar position (top|bottom|left|right)
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "pulseaudio",
    "custom/bluetooth-battery",
    "cpu",
    "memory",
    "temperature",
    "backlight",
    "battery", 
    "custom/powersave",
    "clock", 
    "custom/dnd",
    "network"
  ],
  "hyprland/workspaces": {
    "sort-by-name": true,
    "format": "{name} {icon}",
    "format-icons": {
      "1": "󰈹",
      "2": "",
      "3": "󰇮",
      "4": "",
      "5": "󱍁",
      "6": "󰿎",
      "default": ""
    }
  },
  "hyprland/window": {
    "separate-outputs": true,
    "icon": true,
    "icon-size": 14
  },
  "tray": {
    "icon-size": 14,
    "spacing": 6
  },
  "clock": {
    "interval": 60,
    "format": "{:%Y-%m-%d 󰃭 %I:%M} 󰥔",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
  },
  "cpu": {
    "interval": 10,
    "format": "{usage}% ",
    "tooltip": true,
    "on-click": "$TERMINAL --title cli_system_monitor --command $CLI_SYSTEM_MONITOR"
  },
  "memory": {
    "interval": 10,
    "format": "{used:0.1f}G ",
    "on-click": "$TERMINAL --title cli_system_monitor --command $CLI_SYSTEM_MONITOR"
  },
  "temperature": {
    "interval": 10,
    "critical-threshold": 85,
    "format-critical": "{temperatureC}°C  {icon}",
    "format": "{temperatureC}°C {icon}",
    "format-icons": [
      "",
      "",
      ""
    ],
    "on-click": "$TERMINAL --title cli_system_monitor --command $CLI_SYSTEM_MONITOR"
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ]
  },
  "battery": {
    "interval": 20,
    "states": {
      "good": 80,
      "warning": 40,
      "critical": 20
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󱐋",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    // "format-warning": "{capacity}%  {icon}",
    // "format-critical": "{capacity}%  {icon}", 
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "custom/powersave": {
    "exec": "set-powersave",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "set-powersave toggle"
  },
  "custom/bluetooth-battery": {
    "exec": "bluetooth-battery",
    "return-type": "json",
    "interval": 60
  },
  "custom/dnd": {
    "exec": "if [ \"$(dunstctl is-paused)\" = true ]; then echo '{\"text\":\"󰂛\",\"class\":\"dnd\"}'; else echo '{\"text\":\"󰂚\",\"class\":\"idle\"}'; fi",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "tooltip": false,
    "on-click": "dunstctl set-paused toggle && pkill -SIGRTMIN+8 waybar"
  },
  "network": {
    "interval": 10,
    "format-wifi": "{signalStrength}% ",
    "format-ethernet": "{ifname} 󰈀",
    "tooltip-format": "{ipaddr}/{cidr}, {ifname} via {gwaddr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "on-click": "$TERMINAL --title cli_network_manager --command $CLI_NETWORK_MANAGER"
  },
  "pulseaudio": {
    "ignored-sinks": [
      "Easy Effects Sink",
      "Easy Effects Source",
      "Monitor of Easy Effects Sink"
    ],
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon}  {format_source}",
    "format-bluetooth-muted": "0% {icon}  {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "0% ",
    "format-muted": "0% 󰝟",
    "format-icons": {
      "headphone": "",
      "hands-free": "󱡏",
      "headset": "󱡏",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "$TERMINAL --title cli_sound_manager --command $CLI_SOUND_MANAGER"
  }
}
