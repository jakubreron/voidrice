// Layout and pill shapes adapted from mechabar by sejjy (MIT, https://github.com/sejjy/mechabar)
// The module definitions live in modules/*.jsonc and are merged in through include
{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "height": 0,
  "margin": 0,
  "spacing": 0,
  "reload_style_on_change": true,
  "include": [
    "~/.config/waybar/modules/*.jsonc"
  ],
  "modules-left": [
    "hyprland/workspaces",
    "custom/right#bg_1",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/left#bg_1",
    "temperature",
    "custom/left#bg_2",
    "memory",
    "custom/left#bg_3",
    "cpu",
    "custom/center_divider#bg_3",
    "custom/dnd",
    "clock#time",
    "custom/right#bg_3",
    "clock#date",
    "custom/right#bg_2",
    "network",
    "bluetooth",
    "custom/right#bg_1"
  ],
  "modules-right": [
    "systemd-failed-units",
    "privacy",
    "tray",
    "custom/left#bg_1",
    "group/pulseaudio",
    "custom/left#bg_2",
    "backlight",
    "custom/left#bg_3",
    "battery",
    "power-profiles-daemon",
    "custom/powersave"
  ]
}
