// Layout and pill shapes adapted from mechabar by sejjy (MIT, https://github.com/sejjy/mechabar)
// The module definitions live in modules/*.jsonc and are merged in through include
{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "height": 0,
  "margin": 0,
  "spacing": 0,
  "reload_style_on_change": true,
  "include": [
    "~/.config/waybar/modules/*.jsonc"
  ],
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "temperature",
    "memory",
    "cpu",
    "custom/dnd",
    "clock#time",
    "clock#date",
    "network",
    "bluetooth"
  ],
  "modules-right": [
    "systemd-failed-units",
    "privacy",
    "tray",
    "group/pulseaudio",
    "backlight",
    "battery",
    "power-profiles-daemon",
    "custom/powersave"
  ]
}
