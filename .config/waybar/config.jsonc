// Layout and pill shapes adapted from mechabar by sejjy (MIT, https://github.com/sejjy/mechabar)
{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "height": 0,
  "margin": 0,
  "spacing": 0,
  "reload_style_on_change": true,
  "modules-left": [
    "hyprland/workspaces",
    "custom/right#bg_1",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/left#bg_1",
    "temperature",
    "custom/left#bg_2",
    "memory",
    "custom/left#bg_3",
    "cpu",
    "custom/center_divider#bg_3",
    "custom/dnd",
    "clock#time",
    "custom/right#bg_3",
    "clock#date",
    "custom/right#bg_2",
    "network",
    "bluetooth",
    "custom/right#bg_1"
  ],
  "modules-right": [
    "systemd-failed-units",
    "privacy",
    "tray",
    "custom/left#bg_1",
    "group/pulseaudio",
    "custom/left#bg_2",
    "backlight",
    "custom/left#bg_3",
    "battery",
    "power-profiles-daemon",
    "custom/powersave"
  ],
  "custom/left#bg_1": {
    "format": "",
    "tooltip": false
  },
  "custom/left#bg_2": {
    "format": "",
    "tooltip": false
  },
  "custom/left#bg_3": {
    "format": "",
    "tooltip": false
  },
  "custom/right#bg_1": {
    "format": "",
    "tooltip": false
  },
  "custom/right#bg_2": {
    "format": "",
    "tooltip": false
  },
  "custom/right#bg_3": {
    "format": "",
    "tooltip": false
  },
  "custom/center_divider#bg_3": {
    "format": "|",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "sort-by-name": true,
    "format": "{name} {icon}",
    "format-icons": {
      "1": "󰈹",
      "2": "",
      "3": "󰇮",
      "4": "",
      "5": "󱍁",
      "6": "󰿎",
      "default": ""
    },
    "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'r+1' })\"",
    "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'r-1' })\"",
    "cursor": true
  },
  "hyprland/window": {
    "separate-outputs": true,
    "icon": true,
    "icon-size": 16,
    "rewrite": {
      "": "Desktop"
    }
  },
  "systemd-failed-units": {
    "format": "󰀦 {nr_failed}",
    "hide-on-ok": true,
    "tooltip-format": "Failed units ({nr_failed}):\n{failed_units_list}"
  },
  "privacy": {
    "icon-size": 16,
    "icon-spacing": 8,
    "modules": [
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 16
      },
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 16
      }
    ]
  },
  "tray": {
    "icon-size": 16,
    "spacing": 12,
    "cursor": true
  },
  "temperature": {
    "interval": 10,
    "format": "{icon} {temperatureC}°C",
    "format-icons": [
      "󱃃",
      "󰔏",
      "󱃂"
    ],
    "critical-threshold": 85,
    "format-critical": "󰀦 {temperatureC}°C",
    "min-length": 9,
    "max-length": 9,
    "tooltip-format": "In Fahrenheit: {temperatureF}°F",
    "on-click": "$TERMINAL --title cli_system_monitor --command $CLI_SYSTEM_MONITOR"
  },
  "memory": {
    "interval": 10,
    "format": "󰘚 {percentage}%",
    "states": {
      "warning": 75,
      "critical": 90
    },
    "format-warning": "󰀧 {percentage}%",
    "format-critical": "󰀧 {percentage}%",
    "min-length": 8,
    "max-length": 8,
    "tooltip-format": "Memory Used: {used:0.2f} GiB / {total:0.2f} GiB",
    "on-click": "$TERMINAL --title cli_system_monitor --command $CLI_SYSTEM_MONITOR"
  },
  "cpu": {
    "interval": 10,
    "format": "󰍛 {usage}%",
    "states": {
      "warning": 75,
      "critical": 90
    },
    "format-warning": "󰀨 {usage}%",
    "format-critical": "󰀨 {usage}%",
    "min-length": 8,
    "max-length": 8,
    "tooltip": false,
    "on-click": "$TERMINAL --title cli_system_monitor --command $CLI_SYSTEM_MONITOR"
  },
  "custom/dnd": {
    "exec": "if [ \"$(dunstctl is-paused)\" = true ]; then echo '{\"text\":\"󰂛\",\"class\":\"dnd\"}'; else echo '{\"text\":\"󰂚\",\"class\":\"idle\"}'; fi",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "tooltip": false,
    "on-click": "dunstctl set-paused toggle && pkill -SIGRTMIN+8 waybar"
  },
  "clock#time": {
    "interval": 60,
    "format": "{:%I:%M}",
    "min-length": 5,
    "max-length": 5,
    "tooltip-format": "24-hour time: {:%H:%M}"
  },
  "clock#date": {
    "interval": 60,
    "format": "󰸗 {:%Y-%m-%d}",
    "actions": {
      "on-click": "mode"
    },
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "format": {
        "months": "<span alpha='100%'>{}</span>",
        "days": "<span alpha='85%'>{}</span>",
        "weekdays": "<span alpha='60%'><i>{}</i></span>",
        "today": "<span alpha='100%'><u>{}</u></span>"
      }
    },
    "tooltip-format": "{calendar}"
  },
  "network": {
    "interval": 10,
    "format": "󰤨",
    "format-wifi": "{icon}",
    "format-icons": [
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-disconnected": "󰤯",
    "format-disabled": "󰤮",
    "format-linked": "󱚵",
    "tooltip-format-linked": "Linked without an IP address: {ifname}",
    "format-ethernet": "󰈀",
    "min-length": 2,
    "max-length": 2,
    "on-click": "$TERMINAL --title cli_network_manager --command $CLI_NETWORK_MANAGER",
    "tooltip-format": "Gateway: {gwaddr}",
    "tooltip-format-wifi": "Network: {essid}\nIP Addr: {ipaddr}/{cidr}\nStrength: {signalStrength}%\nFrequency: {frequency} GHz",
    "tooltip-format-disconnected": "Wi-Fi Disconnected",
    "tooltip-format-disabled": "Wi-Fi Off",
    "tooltip-format-ethernet": "Interface: {ifname}"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-on": "󰂰",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "tooltip-format": "Device Addr: {device_address}",
    "tooltip-format-on": "Bluetooth Disconnected",
    "tooltip-format-connected": "Device: {device_alias}",
    "tooltip-format-off": "Bluetooth Off",
    "tooltip-format-disabled": "Bluetooth Disabled",
    "tooltip-format-connected-battery": "Device: {device_alias}\nBattery: {device_battery_percentage}%",
    "tooltip-format-enumerate-connected": "Device: {device_alias}",
    "tooltip-format-enumerate-connected-battery": "Device: {device_alias}\nBattery: {device_battery_percentage}%"
  },
  "group/pulseaudio": {
    "modules": [
      "pulseaudio#output",
      "pulseaudio#input"
    ],
    "orientation": "horizontal",
    "drawer": {
      "transition-left-to-right": false
    }
  },
  "pulseaudio#output": {
    "ignored-sinks": [
      "Easy Effects Sink",
      "Easy Effects Source",
      "Monitor of Easy Effects Sink"
    ],
    "format": "{icon} {volume}%",
    "format-muted": "{icon} {volume}%",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "default-muted": "󰝟",
      "headphone": "󰋋",
      "headphone-muted": "󰟎",
      "headset": "󰋎",
      "headset-muted": "󰋐",
      "hands-free": "󱡏",
      "phone": "",
      "portable": "",
      "car": ""
    },
    "min-length": 8,
    "max-length": 8,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "$TERMINAL --title cli_sound_manager --command $CLI_SOUND_MANAGER",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "tooltip-format": "Output Device: {desc}"
  },
  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭 {volume}%",
    "min-length": 8,
    "max-length": 8,
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
    "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
    "tooltip-format": "Input Device: {desc}"
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "min-length": 8,
    "max-length": 8,
    "on-scroll-up": "light -A 5",
    "on-scroll-down": "light -U 5",
    "tooltip-format": "Screen Brightness"
  },
  "battery": {
    "interval": 20,
    "format": "{icon} {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format-charging": "󰉁 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-alt": "{icon} {time}",
    "states": {
      "warning": 40,
      "critical": 20
    },
    "min-length": 8,
    "max-length": 8,
    "tooltip-format": "Battery Discharging: {time}",
    "tooltip-format-charging": "Battery Charging: {time}",
    "tooltip-format-full": "Battery Full",
    "format-time": "{H}h {M}m"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nCPU driver: {cpu_driver}\nPlatform driver: {platform_driver}",
    "format-icons": {
      "default": "󰗑",
      "performance": "󱓞",
      "balanced": "󰗑",
      "power-saver": "󱈑"
    }
  },
  "custom/powersave": {
    "exec": "set-powersave",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "set-powersave toggle"
  }
}
