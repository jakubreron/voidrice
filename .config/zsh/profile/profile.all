#!/usr/bin/env zsh
#
export TERMINAL="open-terminal"
export BROWSER="firefox"
export BACKUP_BROWSER="chromium"

export EDITOR="nvim"
export GIT_EDITOR="$EDITOR"
export SUDO_EDITOR="/usr/bin/nvim"

export CLI_FILE_EXPLORER="lf"
export CLI_SYSTEM_MONITOR="btop"
export CLI_MAIL_CLIENT="aerc"

export MANPAGER="$EDITOR +Man!"
export MANWIDTH=999

export NODE_OPTIONS="--max-old-space-size=16384"
export GLAMOUR_STYLE="light" # "gh" command theme fix
export SHELL_SESSIONS_DISABLE=1 # stops macOS Terminal creating ~/.zsh_sessions

typeset -U path
path=(
  $XDG_BIN_HOME $XDG_BIN_HOME/**/*(/N)
  $PNPM_HOME
  $NPM_CONFIG_PREFIX/bin
  $BUN_INSTALL/bin
  $CARGO_HOME/bin
  $path
)
export PATH

# Claude Code provider settings and tokens (untracked file, template provider.example.sh): exported to the whole shell, so nvim and every other launcher see them
[ -f "$CLAUDE_CONFIG_DIR/provider.sh" ] && . "$CLAUDE_CONFIG_DIR/provider.sh"

[ ! -f $ZDOTDIR/shortcuts/shortcutrc ] && setsid generate-shell-shortcuts >/dev/null 2>&1
