#!/usr/bin/env zsh
#
export TERMINAL="alacritty"
export BROWSER="firefox"
export BACKUP_BROWSER="chromium"

export EDITOR="nvim"
export GIT_EDITOR="$EDITOR"
export SUDO_EDITOR="/usr/bin/nvim"

export CLI_FILE_EXPLORER="lf"
export CLI_SYSTEM_MONITOR="btop"
export CLI_MAIL_CLIENT="aerc"

export MANPAGER="$EDITOR +Man!"
export MANWIDTH=999

export TMUX_TMPDIR="$XDG_RUNTIME_DIR"
export NODE_OPTIONS="--max-old-space-size=16384"
export GLAMOUR_STYLE="light" # "gh" command theme fix

case "$OS" in
  Linux)
    find_command="find"
    ;;
  Darwin)
    find_command="gfind"
    ;;
esac

local bin_list=(
  "$XDG_DATA_HOME/cargo/bin"
  "$XDG_DATA_HOME/npm/bin"
  "$PNPM_HOME"
  "${$($find_command $XDG_BIN_HOME -type d -printf %p:)%%:}"
  )

for extra in "${bin_list[@]}"; do
  PATH=$extra:$PATH
done
export PATH
unset bin_list

[ ! -f $XDG_CONFIG_HOME/zsh/shortcuts/shortcutrc ] && setsid generate-shell-shortcuts >/dev/null 2>&1
