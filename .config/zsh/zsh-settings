#!/usr/bin/env zsh
#
# General
stty stop undef	# Disable ctrl-s to freeze terminal.

# Prompt
autoload -Uz vcs_info add-zsh-hook
zstyle ':vcs_info:*' enable git svn
zstyle ':vcs_info:git*' formats " (%b)"
add-zsh-hook precmd vcs_info
setopt prompt_subst
prompt='%F{blue}%B%~%b%f${vcs_info_msg_0_} %F{green}❯%f '

# completions
autoload -U compinit && compinit

unsetopt BEEP
setopt HIST_FCNTL_LOCK  # Use system’s fcntl call where available (better performance)
setopt GLOB_DOTS
setopt EXTENDED_GLOB
setopt INTERACTIVE_COMMENTS
setopt EXTENDED_HISTORY          # Write the history file in the ":start:elapsed;command" format.
setopt SHARE_HISTORY             # Share history between all sessions, and write each command immediately.
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate.
setopt HIST_FIND_NO_DUPS         # Do not display a line previously found.
setopt HIST_SAVE_NO_DUPS         # Don't write duplicate entries in the history file.
setopt HIST_IGNORE_SPACE         # Don't record an entry starting with a space.
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks before recording entry.
setopt HIST_VERIFY               # Don't execute immediately upon history expansion.

HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=100000
SAVEHIST=100000

if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi
