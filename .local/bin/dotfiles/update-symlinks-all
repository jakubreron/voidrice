#!/usr/bin/env bash

replace_dotfiles_symlinks() {
  for dir in "$DOTFILES_VOIDRICE_DIR"/.local/bin/*/; do
    dir_name=$(basename "$dir")
    mkdir -p "$XDG_BIN_HOME/$dir_name"
  done

  ignore_args=()
  case "$(uname -s)" in
  Darwin) ;;
  *) ignore_args=(--ignore=Library) ;;
  esac

  # Stow folds a missing target folder into one symlink to the repo. The Claude Code config folder
  # holds runtime data and .claude.json (tokens), so it must exist first: stow then links its entries one by one.
  mkdir -p "$CLAUDE_CONFIG_DIR"

  log-pretty-message "Updating dotfiles symlinks"
  stow --adopt "${ignore_args[@]}" --target="$HOME" --dir="$DOTFILES_DIR" universal voidrice
}

replace_firefox_symlinks() {
  dotfiles_userchrome_path="$DOTFILES_VOIDRICE_DIR/.config/firefox/chrome"
  dotfiles_userjs_overrides_path="$DOTFILES_VOIDRICE_DIR/.config/firefox/user-overrides.js"
  dotfiles_userjs_path="$DOTFILES_VOIDRICE_DIR/.config/firefox/betterfox/user.js"

  if [ -f "$dotfiles_userjs_overrides_path" ]; then
    log-pretty-message "Updating firefox symlinks"

    case "$(uname -s)" in
    Linux*)
      browser_dir="$HOME/.mozilla/firefox"
      xdg_browser_dir="$XDG_CONFIG_HOME/mozilla/firefox"
      [ -f "$xdg_browser_dir/profiles.ini" ] && browser_dir="$xdg_browser_dir"
      ;;
    Darwin) browser_dir="$HOME/Library/Application Support/Firefox" ;;
    esac

    browser_profiles_ini_dir="$browser_dir/profiles.ini"
    profile="$(sed -n "/Default=.*.default-release/ s/.*=//p" "$browser_profiles_ini_dir")"
    browser_profile_dir="$browser_dir/$profile"

    if [ -d "$browser_profile_dir" ]; then
      ln -sf "$dotfiles_userchrome_path" "$browser_profile_dir"

      ln -sf "$dotfiles_userjs_overrides_path" "$browser_profile_dir/user-overrides.js"
      rm -f "$browser_profile_dir/user.js"
      cat "$dotfiles_userjs_path" "$dotfiles_userjs_overrides_path" >"$browser_profile_dir/user.js"
    fi
  fi
}

replace_dotfiles_symlinks
replace_firefox_symlinks
