#!/usr/bin/env bash

LAUNCHER="rofi -dmenu -i -p"
[ -z "${DISPLAY}" ] && LAUNCHER="fzf --prompt "

if [ -f "$XDG_CONFIG_HOME/bm-websites" ]; then
	choice=$( (cat "$XDG_CONFIG_HOME/bm-websites") | $LAUNCHER "Search bookmarks") || exit 1
fi

case "$choice" in *❔*)
	xdg-open "https://duckduckgo.com"
	exit ;;
http*)
	xdg-open "$(echo "$choice" | awk '{print $1}')"
	exit ;;
*) xdg-open "https://duckduckgo.com/?q=$choice"
	exit ;;
esac
