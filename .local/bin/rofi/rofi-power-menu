#!/usr/bin/env bash

# A dmenu wrapper script for system functions.
case "$(readlink -f /sbin/init)" in
	*systemd*) ctl='systemctl' ;;
	*) ctl='loginctl' ;;
esac

case "$(printf "🔒 lock\n🚪 leave $WM\n♻️ renew $WM\n🔋 powersave\n🔃 reboot\n🖥️ shutdown\n⏸️ suspend" | rofi -dmenu -p Action)" in
	'🔒 lock') hyprlock ;;
	"🚪 leave $WM") hyprshutdown ;;
	"♻️ renew $WM")
		hyprctl reload
		# reload re-applies the startup refresh rate; let waybar re-read it
		sleep 1
		pkill -SIGRTMIN+9 waybar
		;;
	'🔋 powersave') set-powersave toggle ;;
	'🔃 reboot') hyprshutdown -t 'Restarting...' --post-cmd 'reboot' ;;
	'🖥️ shutdown') hyprshutdown -t 'Shutting down...' --post-cmd 'shutdown -P 0' ;;
	'⏸️ suspend') $ctl suspend -i ;;
	*) exit 1 ;;
esac
