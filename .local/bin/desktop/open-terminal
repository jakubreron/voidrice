#!/usr/bin/env bash

socket="${XDG_RUNTIME_DIR:-/tmp}/alacritty-$(id -u).sock"
os="$(uname -s)"

if alacritty msg --socket "$socket" create-window "$@" 2>/dev/null; then
  [ "$os" = "Darwin" ] && open -a Alacritty
  exit 0
fi

rm -f "$socket"

if [ "$os" = "Darwin" ]; then
  exec open -n -a Alacritty --args --socket "$socket" "$@"
fi

exec alacritty --socket "$socket" "$@"
