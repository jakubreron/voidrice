#!/usr/bin/env bash

# Powersave toggle for the internal panel, plus a waybar status module.
#   set-powersave          print waybar JSON for the current refresh rate
#   set-powersave toggle   powersave on:  60 Hz + dark theme + keyboard light off + power-saver profile
#                          powersave off: 90 Hz + restores the remembered theme, light and power profile
# Waybar is refreshed through signal 9. Its power-profiles-daemon module follows the profile by itself.

INTERNAL_DESC="Samsung Display Corp. 0x4193"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/set-powersave"
PREV_THEME_FILE="$STATE_DIR/previous-theme"
# Own state file, because hypridle also saves and restores this light with brightnessctl -s and -r
KBD_BACKLIGHT="tpacpi::kbd_backlight"
PREV_KBD_FILE="$STATE_DIR/previous-kbd-backlight"
# CPU power profile, tlpctl comes with tlp-pd and powerprofilesctl with power-profiles-daemon
POWER_PROFILE_SAVING="power-saver"
POWER_PROFILE_FALLBACK="balanced"
PREV_PROFILE_FILE="$STATE_DIR/previous-power-profile"

# Waybar glyphs, written as code points so they survive copy and paste.
# nf-md-leaf and nf-md-speedometer; swap for any Nerd Font glyph you prefer.
ICON_POWERSAVE=$'\U000f032a'
ICON_PERFORMANCE=$'\U000f04c5'

current_rate() {
	hyprctl monitors -j | jq -r --arg d "$INTERNAL_DESC" \
		'[.[] | select(.description == $d)][0].refreshRate // empty | round'
}

current_theme() {
	darkman get 2>/dev/null
}

# Switch theme only when it differs. Succeeds only if a switch was actually made.
set_theme() {
	[ "$(current_theme)" = "$1" ] && return 1
	darkman set "$1"
}

kbd_backlight_off() {
	local level
	level="$(brightnessctl -d "$KBD_BACKLIGHT" get 2>/dev/null)" || return 0 # no keyboard backlight on this machine
	mkdir -p "$STATE_DIR"
	# Keep an older value if one exists and the light is already off (we probably turned it off ourselves).
	if [ ! -f "$PREV_KBD_FILE" ] || [ "$level" -gt 0 ]; then
		echo "$level" >"$PREV_KBD_FILE"
	fi
	brightnessctl -d "$KBD_BACKLIGHT" set 0 >/dev/null
}

kbd_backlight_restore() {
	[ -f "$PREV_KBD_FILE" ] || return 0
	brightnessctl -d "$KBD_BACKLIGHT" set "$(cat "$PREV_KBD_FILE")" >/dev/null
	rm -f "$PREV_KBD_FILE"
}

profile_ctl() {
	if command -v tlpctl >/dev/null 2>&1; then
		tlpctl "$@"
	elif command -v powerprofilesctl >/dev/null 2>&1; then
		powerprofilesctl "$@"
	else
		return 127
	fi
}

power_profile_save() {
	local profile
	profile="$(profile_ctl get 2>/dev/null)" || return 0 # no profile daemon on this machine
	mkdir -p "$STATE_DIR"
	# Keep an older value if one exists, we are probably already in powersave and would remember power-saver.
	if [ ! -f "$PREV_PROFILE_FILE" ]; then
		[ "$profile" = "$POWER_PROFILE_SAVING" ] && profile="$POWER_PROFILE_FALLBACK"
		echo "$profile" >"$PREV_PROFILE_FILE"
	fi
	profile_ctl set "$POWER_PROFILE_SAVING"
}

power_profile_restore() {
	[ -f "$PREV_PROFILE_FILE" ] || return 0
	profile_ctl set "$(cat "$PREV_PROFILE_FILE")"
	rm -f "$PREV_PROFILE_FILE"
}

status() {
	local rate
	rate="$(current_rate)"
	if [ -z "$rate" ]; then
		# Panel disabled (e.g. lid closed): empty text hides the module.
		echo '{"text":""}'
	elif [ "$rate" -gt 60 ]; then
		printf '{"text":"%s","class":"performance","tooltip":"Performance (%s Hz)"}\n' "$rate Hz $ICON_PERFORMANCE" "$rate"
	else
		printf '{"text":"%s","class":"powersave","tooltip":"Powersave (%s Hz)"}\n' "$rate Hz $ICON_POWERSAVE" "$rate"
	fi
}

toggle() {
	local entering target label result prev

	if [ "$(current_rate)" -gt 60 ]; then
		entering=1
		target="2880x1800@60"
	else
		entering=0
		target="highrr"
	fi

	result="$(hyprctl eval "hl.monitor({ output = 'desc:$INTERNAL_DESC', mode = '$target', position = 'auto-down', scale = '1.8' })" 2>&1)"
	if [ "$result" != "ok" ]; then
		notify-send --app-name=display -u critical "Powersave switch failed" "$result"
		return 1
	fi

	# Let the mode switch show up in hyprctl before anything re-reads it.
	sleep 0.5

	if [ "$entering" = 1 ]; then
		# Remember the theme to restore later. Keep an older value if one exists and
		# we are already on dark (we probably set that ourselves, e.g. after a reload
		# reset the refresh rate without leaving powersave).
		mkdir -p "$STATE_DIR"
		if [ ! -f "$PREV_THEME_FILE" ] || [ "$(current_theme)" = "light" ]; then
			current_theme >"$PREV_THEME_FILE"
		fi
		set_theme dark
		kbd_backlight_off
		power_profile_save
		label="🔋 Powersave: on (60 Hz, dark theme, keyboard light off, power-saver profile)"
	else
		kbd_backlight_restore
		power_profile_restore
		label="🔋 Powersave: off (90 Hz)"
		if [ -f "$PREV_THEME_FILE" ]; then
			prev="$(cat "$PREV_THEME_FILE")"
			rm -f "$PREV_THEME_FILE"
			case "$prev" in
				light | dark)
					set_theme "$prev"
					label="🔋 Powersave: off (90 Hz, $prev theme restored)"
					;;
			esac
		fi
	fi

  pkill -SIGRTMIN+9 waybar
	notify-send --app-name=display -t 2000 "$label"
}

case "${1:-status}" in
	toggle) toggle ;;
	*) status ;;
esac
